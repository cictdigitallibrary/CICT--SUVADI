<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for SUVADI on Plesk for Windows.
  Website Document Root must be: httpdocs\suvadi-deploy  (this folder).

  Every request is handed to the Node.js backend (backend\index.js) via iisnode.
  Express serves the API, /images, /songs, /webinc, /storage and the built
  frontend (frontend\dist) with React Router fallback.
  Because nothing is served directly by IIS, source files and .env are never
  exposed as static files.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="backend/index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Block the iisnode remote debugger endpoint -->
        <rule name="BlockNodeInspector" stopProcessing="true">
          <match url="^backend/index\.js\/debug[\/]?" />
          <action type="AbortRequest" />
        </rule>
        <!-- Send everything to the Node.js app -->
        <rule name="SuvadiNodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="backend/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let Express return its own 404/500 responses (JSON for the API) -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- IIS default is ~30 MB; admin PDF uploads can be larger (500 MB) -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <!--
      Restart Node automatically when backend code changes after a Git deploy.
      If Plesk's Node.js is not on the default path, add
      nodeProcessCommandLine="C:\path\to\node.exe" (see deployment notes).
    -->
    <iisnode
      node_env="production"
      watchedFiles="web.config;backend\*.js;backend\chatbot\*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      debuggingEnabled="false" />
  </system.webServer>
</configuration>
