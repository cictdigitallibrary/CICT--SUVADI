<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for SUVADI on Plesk for Windows.
  Website Document Root must be: httpdocs\suvadi-deploy  (this folder).

  Every request is handed to the Node.js backend (backend\index.js) via iisnode.
  Express serves the API, /images, /songs, /webinc, /storage and the built
  frontend (frontend\dist) with React Router fallback.
  Because nothing is served directly by IIS, source files and .env are never
  exposed as static files.

  Node executable: set in backend\iisnode.yml (generated on deploy by
  `npm run deploy:plesk` from the same node.exe that installed the packages).
  Application logs: backend\logs\app-YYYY-MM-DD.log (written by the app itself).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="backend/index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!--
          Drop rewrite rules inherited from the server/Plesk level. An inherited
          "existing file -> serve directly" rule ran before ours, so physical files
          such as /images/ebook_title/tholkapiyam.png never reached Express and IIS
          returned an empty 404. Rules below then apply to every request.
        -->
        <clear />
        <!-- HTTP -> HTTPS, previously provided by the inherited rules -->
        <rule name="SuvadiHttpsRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Block the iisnode remote debugger endpoint -->
        <rule name="BlockNodeInspector" stopProcessing="true">
          <match url="^backend/index\.js\/debug[\/]?" />
          <action type="AbortRequest" />
        </rule>
        <!-- Send everything to the Node.js app -->
        <rule name="SuvadiNodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="backend/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let Express return its own 404/500 responses (JSON for the API) -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Largest single upload IIS accepts: 2 GB. The application itself sets no size
             limit; the largest edition PDF today is ~692 MB, so the former 500 MB cap
             blocked replacing it. IIS cannot go beyond 4 GB (4294967295 bytes). -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>

    <!--
      watchedFiles and configOverrides are resolved relative to the startup
      script's folder (backend\), so iisnode.yml means backend\iisnode.yml.
      Every folder listed in watchedFiles must exist. Changes restart Node.
      iisnode's own log folder is disabled: the app writes backend\logs itself.
      One Node process per site keeps PostgreSQL usage at a single pool (max 10).
    -->
    <iisnode
      node_env="production"
      configOverrides="iisnode.yml"
      watchedFiles="*.js;chatbot\*.js;iisnode.yml"
      nodeProcessCountPerApplication="1"
      loggingEnabled="false"
      devErrorsEnabled="false"
      debuggingEnabled="false" />
  </system.webServer>
</configuration>
